# Base URL of the future Node.js backend API.
# Not used until VITE_USE_MOCKS=false.
VITE_API_URL=http://localhost:3000/api

# When true (default), all data comes from the in-memory/localStorage mock
# service layer in src/services/mock. Set to false once a real backend
# implementing the same service contracts is available.
VITE_USE_MOCKS=true
