# Base URL of the Node.js backend API.
VITE_API_URL=http://localhost:3000/api

# When true (default), most data comes from the in-memory/localStorage mock service layer in
# src/services/mock. Set to false once a real backend implementing the same service contracts
# is available. Authentication always hits the real backend regardless of this flag.
VITE_USE_MOCKS=true

# Auth0 — the sole identity provider (Universal Login). Must exactly match the backend's
# AUTH0_DOMAIN / AUTH0_AUDIENCE (jdm_experience_backend's .env). See docs/API.md for the
# required Post-Login Action that stamps a verified email onto the access token.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# The tour itinerary map (Leaflet) uses OpenStreetMap data via CARTO's raster basemap tiles.
# CARTO now requires an API key to remove the "API key required" watermark (free tier, 5M tile
# requests/month) -- get one at carto.com/basemaps/apikey. Optional: unset, the map still renders,
# just with the watermark.
VITE_CARTO_API_KEY=
